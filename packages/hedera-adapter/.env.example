# Copy to .env (git-ignored). NEVER commit real values.
# HEDERA_PRIVATE_KEY is the treasury signing key. It must never appear in code, logs,
# fixtures, error messages, screenshots, the demo video, or an AI agent's context.

HEDERA_NETWORK=testnet

# Treasury account. Fund it with a WORKING FLOAT, not the whole budget — compromise of
# the paying module costs whatever sits in this account.
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=

# Optional; defaults per network.
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# Hard ceiling per payment, in the asset's smallest unit. Enforced before signing.
# 100000000 tinybars = 1 HBAR.
MAX_PAYMENT_AMOUNT=100000000

# Deployed CommonBudget contract. Not a secret.
COMMON_CONTRACT_ADDRESS=
HCS_TOPIC_ID=

# Resource used by `npm run pay:once`.
RESOURCE_URL=http://localhost:3002/datasets/daily-transfers
