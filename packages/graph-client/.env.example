# Copy to .env (git-ignored). Names only — never commit values.
# This module READS. It holds no keys and can authorize no spending.

# GraphQL endpoint for the deployed subgraph.
#   local graph-node : http://localhost:8000/subgraphs/name/common/budget
#   hosted provider  : the query URL from that provider
GRAPH_ENDPOINT=

# Bearer token for a hosted gateway. Leave empty for a local graph-node.
GRAPH_API_KEY=

# Enables decision-rationale hydration from HCS. Without both, rationale is reported
# as unavailable rather than guessed.
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com
HCS_DECISION_TOPIC_ID=0.0.10465595

# Optional. Used only to read the chain head so index lag is a number rather than a
# guess. Without it, sync status is honestly reported as "unknown".
GRAPH_CHAIN_HEAD_RPC_URL=https://testnet.hashio.io/api
