# Copy to .env (git-ignored) or set in your shell session. NEVER commit real values.
#
# ECDSA hex private key for the deploying account, 0x-prefixed.
# Must be ECDSA, not ED25519 — the EVM JSON-RPC relay cannot use ED25519 keys.
HEDERA_EVM_PRIVATE_KEY=

# Optional. Defaults to Hashio's public testnet relay.
HEDERA_JSON_RPC_URL=https://testnet.hashio.io/api

# Deployed CommonBudget address, printed by `npm run deploy:testnet`. Not a secret.
COMMON_CONTRACT_ADDRESS=

# Hedera account id (0.0.x) that receives payments in the paid service. Not a secret.
PAY_TO_ACCOUNT_ID=
