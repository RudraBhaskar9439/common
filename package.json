{
  "name": "common",
  "version": "0.0.0",
  "private": true,
  "description": "Shared spending memory for AI agents \u2014 ETHOnline 2026",
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run demo:mock",
    "demo:mock": "tsx apps/orchestrator/src/demo.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "tsx --test tests/interfaces/*.test.ts",
    "test:modules": "npm test --workspaces --if-present",
    "test:subgraph": "npm --prefix subgraph test",
    "check": "npm run typecheck && npm run build && npm test",
    "check:all": "npm run check && npm run test:modules"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  }
}
