[Unit]
Description=Common application and orchestrator
After=network-online.target ollama.service common-provider.service
Wants=network-online.target

[Service]
Type=simple
User=common
Group=common
WorkingDirectory=/opt/common
EnvironmentFile=/etc/common/app.env
ExecStart=/usr/local/bin/node --import tsx apps/orchestrator/src/server.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/common/app /var/lib/common/practice
UMask=0077

[Install]
WantedBy=multi-user.target
