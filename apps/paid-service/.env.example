# Copy to .env (git-ignored). This service holds NO KEYS and signs nothing.
# It states a price and verifies payment through the facilitator.

PORT=3002

# Blocky402 hosted testnet facilitator. Open access, no API key.
BLOCKY402_FACILITATOR_URL=https://api.testnet.blocky402.com
HEDERA_NETWORK=testnet

# Hedera account id (0.0.x) that receives payment. Not a secret.
PAY_TO_ACCOUNT_ID=

# Price in the asset's smallest unit. HBAR is tinybars: 50000000 = 0.5 HBAR.
PRICE_AMOUNT=50000000
# "0.0.0" is HBAR. An HTS token id also requires association on both accounts.
PRICE_ASSET_ID=0.0.0

# Validity window for the signed transfer.
MAX_TIMEOUT_SECONDS=180

# The facilitator's own account, which pays gas and submits. The Hedera `exact`
# scheme requires transactionId.accountId to equal this value.
# Discover it from `npm run supported` — do not guess.
FACILITATOR_FEE_PAYER_ACCOUNT_ID=
