# Copy to .env (git-ignored). This service holds NO KEYS and signs nothing.
# It states a price and verifies payment through the facilitator.

PORT=3002

# Blocky402 hosted testnet facilitator. Open access, no API key.
BLOCKY402_FACILITATOR_URL=https://api.testnet.blocky402.com
HEDERA_NETWORK=testnet

# Hedera account id (0.0.x) that receives payment. Not a secret.
PAY_TO_ACCOUNT_ID=

# Price in the asset's smallest unit. HBAR is tinybars: 50000000 = 0.5 HBAR.
PRICE_AMOUNT=50000000
# "0.0.0" is HBAR. An HTS token id also requires association on both accounts.
PRICE_ASSET_ID=0.0.0

# Validity window for the signed transfer.
MAX_TIMEOUT_SECONDS=180

# The facilitator's own account, which pays gas and submits. The Hedera `exact`
# scheme requires transactionId.accountId to equal this value.
# Discover it from `npm run supported` — do not guess.
FACILITATOR_FEE_PAYER_ACCOUNT_ID=

# --- The Graph: the paid resource -------------------------------------------
# Datasets are live Subgraph data, pinned to a block so two buyers of the same
# purchase key provably receive identical bytes.
#
# Create a key at https://thegraph.com/studio. It is sent as an Authorization
# header, never in the URL — `resource` is written on chain and must not carry it.
GRAPH_API_KEY=

# Uniswap V3 on Ethereum mainnet, verified resolving on the decentralized network.
# The pinned block must be valid for
# the chain the subgraph indexes: an Ethereum block number means nothing to an
# Arbitrum deployment, and the gateway reports that unhelpfully.
GRAPH_SUBGRAPH_ID=5zvR82QoaXYFyDEKLZ9t6v9adgnptxYpKpSbxtgVENFV
GRAPH_GATEWAY_URL=https://gateway.thegraph.com/api/subgraphs/id

# Optional. Defaults to the subgraph's indexed head minus 1000, so the block is
# final and the answer is stable. Validate with `npm run gateway:check`.
GRAPH_PINNED_BLOCK=
