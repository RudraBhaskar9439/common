# Local inference is the default. No wallet or paid hosting required.
COMMON_MODE=local
COMMON_READ_ONLY=no
COMMON_PORT=3000
COMMON_DATA_DIR=.common-data
COMMON_WORKSPACE_ID=local-demo
PAID_SERVICE_URL=http://127.0.0.1:3002

# Live mode must be selected explicitly after configuring and verifying testnet.
HEDERA_NETWORK=testnet
CONFIRM_TESTNET_PAYMENT=no
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=
HEDERA_EVM_PRIVATE_KEY=
COMMON_CONTRACT_ADDRESS=
HCS_TOPIC_ID=
MAX_PAYMENT_AMOUNT=100000000
PAY_TO_ACCOUNT_ID=
FACILITATOR_FEE_PAYER_ACCOUNT_ID=
PRICE_AMOUNT=50000000
WORKSPACE_BUDGET_TINYBAR=100000000
PUBLIC_SERVICE_URL=http://127.0.0.1:3002

# Buyer agent. "policy" is deterministic and needs no key. "openai" lets a small model
# decide buy / reuse / reject from the goal, budget and shared memory; it falls back to
# policy if the key is missing or the API fails. The orchestrator still enforces the rules.
COMMON_BUYER=policy
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Any OpenAI-compatible endpoint works, e.g. OpenRouter with OPENAI_MODEL=openai/gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
